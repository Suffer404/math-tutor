# Environment Configuration Example

# Copy this file to .env and fill in your values

# ============================================
# AI Provider Configuration (Optional)
# ============================================
# Set to 'mock', 'openai', or 'anthropic'
# Default: 'mock' (works offline, no API key needed)
AI_PROVIDER=mock

# OpenAI Configuration (if AI_PROVIDER=openai)
# Get your key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic Configuration (if AI_PROVIDER=anthropic)
# Get your key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file
# Default: math_tutor.db in project root
MATH_TUTOR_DB_PATH=math_tutor.db

# ============================================
# Backend Server Configuration
# ============================================
# Host to bind (keep as 127.0.0.1 for security)
BACKEND_HOST=127.0.0.1

# Port for FastAPI server
# Default: 8000
BACKEND_PORT=8000

# ============================================
# Frontend Configuration
# ============================================
# Vite dev server port
# VITE_PORT=5173

# API base URL for frontend (adjust if backend runs elsewhere)
# VITE_API_BASE=http://127.0.0.1:8000