# Environment Configuration Example

# Copy this file to .env and fill in your values

# ============================================
# AI Provider Configuration (Optional)
# ============================================
# Set to 'mock', 'openai', 'anthropic', 'requesty', or 'custom'
# Default: 'mock' (works offline, no API key needed; live handwriting check is disabled)
AI_PROVIDER=mock

# Optional: a separate image-capable model for live handwriting checks.
# The text model above may be text-only. If unset, the text model is used for
# images too (it must accept images or live check will fail honestly).
# AI_VISION_MODEL=openai/gpt-4o-mini
# REQUESTY_VISION_MODEL=openai/gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# ANTHROPIC_VISION_MODEL=claude-3-haiku-20240307

# OpenAI Configuration (if AI_PROVIDER=openai)
# Get your key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic Configuration (if AI_PROVIDER=anthropic)
# Get your key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Requesty AI Router Configuration (if AI_PROVIDER=requesty)
# Get your key from https://router.requesty.ai/
# REQUESTY_API_KEY=rqsty-sk-...

# Radox AI Configuration
# RADOX_AI_URL=https://radoxai.com/v1
# RADOX_AI_API_KEY=your_key_here

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file
# Default: math_tutor.db in project root
MATH_TUTOR_DB_PATH=math_tutor.db

# ============================================
# Backend Server Configuration
# ============================================
# Host to bind (keep as 127.0.0.1 for security)
BACKEND_HOST=127.0.0.1

# Port for FastAPI server
# Default: 8000
BACKEND_PORT=8000

# ============================================
# Frontend Configuration
# ============================================
# Vite dev server port
# VITE_PORT=5173

# API base URL for frontend (adjust if backend runs elsewhere)
# VITE_API_BASE=http://127.0.0.1:8000